{
  "name": "authentication",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/authentication/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/authentication",
        "browser": "apps/authentication/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/authentication/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/authentication/public"
          }
        ],
        "styles": [
          "apps/authentication/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "50mb",
              "maximumError": "80mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "50mb",
              "maximumError": "80mb"
            }
          ],
          "outputHashing": "all",
          "sourceMap": {
            "scripts": true,
            "styles": false,
            "hidden": true,
            "vendor": false
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 5200
      },
      "configurations": {
        "production": {
          "buildTarget": "authentication:build:production"
        },
        "development": {
          "buildTarget": "authentication:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "authentication:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/authentication/jest.config.ts",
        "tsConfig": "apps/authentication/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "authentication:build",
        "port": 5200,
        "staticFilePath": "dist/apps/authentication/browser",
        "spa": true
      }
    }
  }
}