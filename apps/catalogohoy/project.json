{
  "name": "catalogohoy",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/catalogohoy/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/catalogohoy",
        "browser": "apps/catalogohoy/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/catalogohoy/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/catalogohoy/public"
          },
          {
            "glob": "pdf.worker.min.mjs",
            "input": "node_modules/pdfjs-dist/build",
            "output": "."
          }
        ],
        "styles": [
          "apps/catalogohoy/src/styles.css",
          "node_modules/quill/dist/quill.snow.css",
          "node_modules/@ctrl/ngx-emoji-mart/picker.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "10mb",
              "maximumError": "15mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "100kb",
              "maximumError": "150kb"
            }
          ],
          "outputHashing": "all",
          "sourceMap": {
            "scripts": true,
            "styles": false,
            "hidden": true,
            "vendor": false
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "libs/catalogohoy/environments/src/environment.ts",
              "with": "libs/catalogohoy/environments/src/environment.development.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "catalogohoy:build:production"
        },
        "development": {
          "buildTarget": "catalogohoy:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "catalogohoy:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/catalogohoy/jest.config.ts",
        "tsConfig": "apps/catalogohoy/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "catalogohoy:build",
        "port": 4200,
        "staticFilePath": "dist/apps/catalogohoy/browser",
        "spa": true
      }
    }
  }
}