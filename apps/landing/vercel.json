{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/precios",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/funciones",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/preguntas-frecuentes",
      "destination": "/faq",
      "permanent": true
    }
  ]
}