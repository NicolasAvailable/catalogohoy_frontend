{
  "name": "internal",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/internal/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/internal",
        "browser": "apps/internal/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/internal/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/internal/public"
          }
        ],
        "styles": [
          "apps/internal/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "10mb",
              "maximumError": "15mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "100kb",
              "maximumError": "150kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "libs/catalogohoy/environments/src/environment.ts",
              "with": "libs/catalogohoy/environments/src/environment.development.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 6200
      },
      "configurations": {
        "production": {
          "buildTarget": "internal:build:production"
        },
        "development": {
          "buildTarget": "internal:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "internal:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/internal/jest.config.ts",
        "tsConfig": "apps/internal/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "internal:build",
        "port": 6200,
        "staticFilePath": "dist/apps/internal/browser",
        "spa": true
      }
    }
  }
}
