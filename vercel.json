{
  "buildCommand": "npm run build:catalogohoy",
  "outputDirectory": "dist/apps/catalogohoy/browser",
  "functions": {
    "api/og.ts": {
      "includeFiles": "dist/apps/catalogohoy/browser/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/product/:id",
      "destination": "/api/og?path=product/:id"
    },
    {
      "source": "/",
      "destination": "/api/og"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
