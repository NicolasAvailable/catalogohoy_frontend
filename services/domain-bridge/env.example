# Copiar a /etc/domain-bridge.env (chmod 600). Nunca subir este archivo con valores reales.
# systemd no acepta comentarios al final de una línea: van solo en líneas propias.
BRIDGE_SECRET=cambia-esto-por-un-secreto-largo
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
# La IP fija de este servidor (la misma de la lista blanca de Namecheap).
NAMECHEAP_CLIENT_IP=
# 1 = sandbox (pruebas). Quitar para producción.
NAMECHEAP_SANDBOX=1
PORT=8787

# Titular de los dominios: CATALOGOHOY, LLC
REGISTRANT_FIRST_NAME=
REGISTRANT_LAST_NAME=
REGISTRANT_ORG=CATALOGOHOY, LLC
REGISTRANT_ADDRESS1=
REGISTRANT_CITY=
REGISTRANT_STATE=
REGISTRANT_ZIP=
REGISTRANT_COUNTRY=US
REGISTRANT_PHONE=+1.0000000000
REGISTRANT_EMAIL=
