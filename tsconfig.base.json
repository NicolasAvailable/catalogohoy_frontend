{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ui": ["libs/ui/src/index.ts"],
      "@shared/application": ["libs/shared/application/src/index.ts"],
      "@shared/domain": ["libs/shared/domain/src/index.ts"],
      "@shared/infrastructure": ["libs/shared/infrastructure/src/index.ts"],
      "@shared/presenter": ["libs/shared/presenter/src/index.ts"],
      "@catalogohoy/core": ["libs/catalogohoy/core/src/index.ts"],
      "@catalogohoy/env": ["libs/catalogohoy/environments/src/index.ts"],
      "@catalogohoy/auth": ["libs/catalogohoy/auth/src/index.ts"],
      "@catalogohoy/profile": ["libs/catalogohoy/profile/src/index.ts"],
      "@catalogohoy/tenant": ["libs/catalogohoy/tenant/src/index.ts"],
      "@catalogohoy/e-commerce": ["libs/catalogohoy/e-commerce/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
